    <string name="no_paired_devices_hint">No paired devices yet. Tap Add New Device to generate a QR code or join a device.</string>
<string name="watchdog_desc">Enable background watchdog to automatically restart the FileApex file server daemon if aggressive OEM battery management terminates it in the background. Peer UDP wake only works while the share-server notification is active.</string>
    <string name="background_restricted_desc">Android is blocking FileApex from running in the background. Tap to open App battery usage and set FileApex to Unrestricted or Always allow.</string>
    <string name="background_restricted_desc_steps">Android is blocking FileApex from running in the background. Tap to open system settings, then choose: %1$s</string>
    <string name="battery_optimization_desc">FileApex is not exempt from classic battery optimization. Tap to request unrestricted battery. On many phones you must also set App battery usage to Unrestricted or Always allow.</string>
    <string name="pause_unused_desc">Android may hibernate FileApex when you have not opened it recently. Tap to turn off this restriction so the share server stays running overnight.</string>
    <string name="vendor_setup">%1$s setup</string>
    <string name="exact_alarms_desc">Alarms &amp; reminders permission is off. The service watchdog may fire late or miss restarts after OEM kills. Tap to open system alarm settings and allow FileApex.</string>
    <string name="system_app_settings_desc">Opens FileApex in Android app settings. After an app update, open FileApex once so the share server can restart.</string>
    <string name="start_share_after_reboot_desc">When on, FileApex starts its share server automatically after your device finishes rebooting. Off leaves the server stopped until you open the app.</string>
    <string name="bulletin_board_notif_desc">Show a notification when new shared messages, files, or alerts arrive from paired devices.</string>
    <string name="drive_relay_notif_desc">Alerts when FileApex posts or retrieves files through Google Drive Relay.</string>
    <string name="drive_relay_notif_off">Turns on after Google Drive Relay is enabled under Google Account.</string>
    <string name="file_transfer_notif_desc">Show a notification after files are successfully received from paired devices.</string>
    <string name="live_activity_desc">Shows progress of active file transfers in a floating capsule. Queued items use the header clock icon.</string>
    <string name="show_receive_notif_desc">When on, this device shows a notification after files are received successfully (includes filenames). Off keeps transfers silent. Applies only when receiving, not when sending. Default is off.</string>
    <string name="remote_delete_desc">This allows the Bulletin Board to \"delete all\" for files in local storage remotely.</string>
    <string name="drive_relay_desc">Store relayed files in a FileApex Relay folder on your Google Drive. Works on Wi‑Fi. FileApex cannot see your other Drive files. Desktop has no FCM, so it checks that folder on launch and every 15 minutes when off Wi‑Fi.</string>
    <string name="drive_cellular_desc">Also use Google Drive Relay when this device is off local Wi‑Fi. Separate from clipboard Via Cellular.</string>
    <string name="relay_size_limit_desc">Max size for one Google Drive Relay send — a single file, or a selected group at once. Default is %1$s.</string>
    <string name="purge_after_72h_desc">Delete unpinned Drive relay files 72 hours after upload. Direct transfers are also removed as soon as the destination device retrieves them.</string>
    <string name="delete_relay_now_desc">Remove every file in FileApex Relay immediately, including uploads that never downloaded. Does not wait 72 hours.</string>
    <string name="deleting">Deleting…</string>
    <string name="device_details_intro">Configure which telemetry fields appear when you open Device Details for a paired device. Wi-Fi and cellular rows are shown only when the peer is on that network type.</string>
    <string name="allow_over_cellular_desc">When off-LAN, fetch or share encrypted Device Details via Firebase. Both devices must enable this and link a Google Account. Same Wi-Fi still uses local network (not encrypted).</string>
    <string name="expanded_layout_desc">When on, always uses the adaptive multi-pane layout with navigation rail and list-detail, regardless of window size. When off, uses the compact single-column layout. Default is Compact.</string>
    <string name="windows_fluent_desc">Standard keeps the cross-platform look (same as Android). Modern uses native Windows styling and a Mica title bar. Saved on this PC; applies immediately.</string>
    <string name="check_updates_desc">When on, FileApex checks GitHub Releases on your schedule and installs newer builds for this platform. Default is off.</string>
    <string name="require_pin_desc">When on, other devices must enter this device\'s PIN to pair and to browse files. Sending files to this device does not require PIN. Default is off. Only this device stores the PIN.</string>
    <string name="browse_unlock_idle">Browse unlock idle timeout</string>
    <string name="browse_unlock_idle_desc">How long this device stays unlocked when browsing a PIN-protected peer. Returning to the device list always re-locks. Default is 5 Minutes.</string>
    <string name="link_google_desc">Opt-in only. Signs in with Google and registers this device’s public ID and LAN address in your private Firebase registry so other FileApex apps on the same account can discover you. Files are uploaded only when Google Drive Relay is also enabled.</string>
    <string name="linked_email">Linked: %1$s</string>
